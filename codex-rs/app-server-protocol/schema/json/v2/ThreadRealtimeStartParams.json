{
  "$defs": {
    "RealtimeOutputModality": {
      "enum": [
        "text",
        "audio"
      ],
      "type": "string"
    },
    "RealtimeVoice": {
      "enum": [
        "alloy",
        "arbor",
        "ash",
        "ballad",
        "breeze",
        "cedar",
        "coral",
        "cove",
        "echo",
        "ember",
        "juniper",
        "maple",
        "marin",
        "sage",
        "shimmer",
        "sol",
        "spruce",
        "vale",
        "verse"
      ],
      "type": "string"
    },
    "ThreadRealtimeStartTransport": {
      "description": "EXPERIMENTAL - transport used by thread realtime.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "websocket",
              "title": "WebsocketThreadRealtimeStartTransportType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "WebsocketThreadRealtimeStartTransport",
          "type": "object"
        },
        {
          "properties": {
            "sdp": {
              "description": "SDP offer generated by a WebRTC RTCPeerConnection after configuring audio and the\nrealtime events data channel.",
              "type": "string"
            },
            "type": {
              "const": "webrtc",
              "title": "WebrtcThreadRealtimeStartTransportType",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sdp"
          ],
          "title": "WebrtcThreadRealtimeStartTransport",
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "EXPERIMENTAL - start a thread-scoped realtime session.",
  "properties": {
    "outputModality": {
      "$ref": "#/$defs/RealtimeOutputModality",
      "description": "Selects text or audio output for the realtime session. Transport and voice stay\nindependent so clients can choose how they connect separately from what the model emits."
    },
    "prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "realtimeSessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": "string"
    },
    "transport": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadRealtimeStartTransport"
        },
        {
          "type": "null"
        }
      ]
    },
    "voice": {
      "anyOf": [
        {
          "$ref": "#/$defs/RealtimeVoice"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "threadId",
    "outputModality"
  ],
  "title": "ThreadRealtimeStartParams",
  "type": "object"
}