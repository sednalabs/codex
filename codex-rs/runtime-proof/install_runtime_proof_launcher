#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly launcher_name=codex-runtime-proof-launcher
readonly target_dir=/usr/libexec/codex
readonly target_path="${target_dir}/${launcher_name}"

temporary_path=
rollback_temporary_path=
created_target_dir=0
parent_mode_before=
parent_mode_changed=0
replacement_complete=0

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if (( status != 0 && replacement_complete == 0 )); then
    if [[ -f "${target_path}" && ! -L "${target_path}" ]]; then
      installed_digest=$(sha256sum < "${target_path}")
      installed_digest=${installed_digest%% *}
      [[ "${installed_digest}" == "${expected_digest:-}" ]] && replacement_complete=1
    fi
  fi
  if (( status != 0 && replacement_complete == 0 )); then
    [[ -z "${temporary_path}" ]] || rm -f -- "${temporary_path}"
    [[ -z "${rollback_temporary_path}" ]] || rm -f -- "${rollback_temporary_path}"
    if (( parent_mode_changed == 1 )) && [[ -d "${target_dir}" && ! -L "${target_dir}" ]]; then
      chmod "${parent_mode_before}" -- "${target_dir}" 2>/dev/null || true
    fi
    if (( created_target_dir == 1 )); then
      rmdir -- "${target_dir}" 2>/dev/null || true
    fi
  fi
  exit "${status}"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

if (( EUID != 0 )); then
  fail 'Run the fixed runtime-proof launcher installer with root privileges.'
fi
if (( $# != 0 )); then
  fail 'The fixed runtime-proof launcher installer accepts no arguments.'
fi

script_path=${BASH_SOURCE[0]}
[[ ! -L "${script_path}" && -f "${script_path}" ]] || fail 'The package installer must be a regular file.'
package_dir=$(cd -- "$(dirname -- "${script_path}")" && pwd -P)
launcher_path="${package_dir}/${launcher_name}"
checksum_path="${package_dir}/${launcher_name}.sha256"
[[ -f "${launcher_path}" && ! -L "${launcher_path}" && -x "${launcher_path}" ]] || fail 'The packaged launcher is not a regular executable.'
[[ -f "${checksum_path}" && ! -L "${checksum_path}" ]] || fail 'The package launcher checksum is missing.'
checksum_size=$(stat -c '%s' -- "${checksum_path}")
(( checksum_size <= 128 )) || fail 'The package launcher checksum is too large.'

checksum_line=$(cat -- "${checksum_path}")
[[ "${checksum_line}" =~ ^([0-9a-f]{64})[[:space:]][[:space:]]${launcher_name}$ ]] || fail 'The package launcher checksum format is invalid.'
expected_digest=${BASH_REMATCH[1]}

for trusted_parent in /usr /usr/libexec; do
  [[ -d "${trusted_parent}" && ! -L "${trusted_parent}" ]] || fail 'A fixed launcher parent is missing or unsafe.'
  IFS=: read -r owner group mode < <(stat -c '%u:%g:%a' -- "${trusted_parent}")
  [[ "${owner}" == 0 && "${group}" == 0 ]] || fail 'A fixed launcher parent is not root-owned.'
  mode_value=$((8#${mode}))
  (( (mode_value & 07022) == 0 && (mode_value & 0001) != 0 )) || fail 'A fixed launcher parent is writable or not traversable.'
done

if [[ -e "${target_dir}" || -L "${target_dir}" ]]; then
  [[ -d "${target_dir}" && ! -L "${target_dir}" ]] || fail 'The fixed launcher directory is not a regular directory.'
  IFS=: read -r owner group parent_mode_before < <(stat -c '%u:%g:%a' -- "${target_dir}")
  [[ "${owner}" == 0 && "${group}" == 0 ]] || fail 'The fixed launcher directory is not root-owned.'
  mode_value=$((8#${parent_mode_before}))
  (( (mode_value & 07022) == 0 )) || fail 'The fixed launcher directory is writable or has special permission bits.'
else
  install -d -o root -g root -m 0711 -- "${target_dir}"
  created_target_dir=1
fi

previous_digest=
if [[ -e "${target_path}" || -L "${target_path}" ]]; then
  [[ -f "${target_path}" && ! -L "${target_path}" ]] || fail 'The installed launcher is not a regular file.'
  IFS=: read -r owner group target_mode target_size < <(stat -c '%u:%g:%a:%s' -- "${target_path}")
  [[ "${owner}" == 0 && "${group}" == 0 && "${target_size}" -gt 0 && "${target_size}" -le 2147483648 ]] || fail 'The installed launcher is outside its fixed file contract.'
  mode_value=$((8#${target_mode}))
  (( (mode_value & 0022) == 0 && (mode_value & 0111) != 0 && (mode_value & 06000) == 0 )) || fail 'The installed launcher permissions are unsafe.'
  previous_digest=$(sha256sum < "${target_path}")
  previous_digest=${previous_digest%% *}
fi

if [[ "${previous_digest}" != "${expected_digest}" ]]; then
  temporary_path=$(mktemp "${target_dir}/.launcher-install.XXXXXX")
  install -o root -g root -m 0700 -- "${launcher_path}" "${temporary_path}"
  staged_digest=$(sha256sum < "${temporary_path}")
  staged_digest=${staged_digest%% *}
  [[ "${staged_digest}" == "${expected_digest}" ]] || fail 'The staged launcher does not match its package checksum.'
  chmod 0755 -- "${temporary_path}"

  if [[ -n "${previous_digest}" ]]; then
    rollback_path="${target_dir}/.codex-runtime-proof-launcher.rollback-${previous_digest}"
    if [[ -e "${rollback_path}" || -L "${rollback_path}" ]]; then
      [[ -f "${rollback_path}" && ! -L "${rollback_path}" ]] || fail 'The matching rollback path is unsafe.'
      IFS=: read -r owner group rollback_mode < <(stat -c '%u:%g:%a' -- "${rollback_path}")
      [[ "${owner}" == 0 && "${group}" == 0 && "${rollback_mode}" == 600 ]] || fail 'The matching rollback image is outside root-only custody.'
      rollback_digest=$(sha256sum < "${rollback_path}")
      [[ "${rollback_digest%% *}" == "${previous_digest}" ]] || fail 'The matching rollback image digest does not match.'
    else
      rollback_temporary_path=$(mktemp "${target_dir}/.launcher-rollback.XXXXXX")
      install -o root -g root -m 0600 -- "${target_path}" "${rollback_temporary_path}"
      rollback_digest=$(sha256sum < "${rollback_temporary_path}")
      [[ "${rollback_digest%% *}" == "${previous_digest}" ]] || fail 'The preserved rollback image does not match the installed predecessor.'
      rollback_path="${target_dir}/.codex-runtime-proof-launcher.rollback-${previous_digest}"
      mv -T -- "${rollback_temporary_path}" "${rollback_path}"
      rollback_temporary_path=
    fi
  fi

  if [[ -n "${parent_mode_before}" ]]; then
    chmod 0711 -- "${target_dir}"
    parent_mode_changed=1
  fi
  mv -T -- "${temporary_path}" "${target_path}"
  temporary_path=
  replacement_complete=1
else
  if [[ -n "${parent_mode_before}" && "${parent_mode_before}" != 711 ]]; then
    chmod 0711 -- "${target_dir}"
    parent_mode_changed=1
  fi
  replacement_complete=1
fi

sync -f "${target_dir}"
printf '%s\n' 'The fixed runtime-proof launcher package is installed. No service was started or reloaded.'
