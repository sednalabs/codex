load("//:defs.bzl", "codex_rust_crate", "workspace_root_test")

codex_rust_crate(
    name = "rollout",
    crate_name = "codex_rollout",
)

# This single regression must chown a file to a host supplementary group. Run
# only this ignored libtest case without linux-sandbox so Bazel's user namespace
# cannot replace an unmapped host GID with the overflow GID.
workspace_root_test(
    name = "rollout-alternate-group-materialization-test",
    args = [
        "--ignored",
        "--exact",
        "compression::tests::worker_preserves_alternate_group_through_materialization",
    ],
    # Keep this ownership regression on the host: a sandbox user namespace
    # can expose the unmapped overflow GID (65534) instead of the runner's
    # actual supplementary groups. `local` also prevents remote execution.
    tags = [
        "local",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    test_bin = ":rollout-unit-tests-bin",
    workspace_root_marker = "//codex-rs/utils/cargo-bin:repo_root.marker",
)
