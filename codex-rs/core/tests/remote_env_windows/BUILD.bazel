load("//bazel/rules/testing/wine:wine.bzl", "wine_rust_test")

wine_rust_test(
    name = "smoke-test",
    # The test has its own 120s event timeout; keep Bazel's target budget above
    # that so hosted Wine slowdowns surface test diagnostics instead of a 60s kill.
    timeout = "moderate",
    srcs = ["remote_env_windows_test.rs"],
    crate_name = "remote_env_windows_test",
    crate_root = "remote_env_windows_test.rs",
    windows_binaries = {
        "wine-windows-exec-server": "//codex-rs/exec-server/testing:windows-exec-server",
    },
    deps = [
        "//codex-rs/app-server/tests/common",
        "//codex-rs/app-server-protocol",
        "//codex-rs/core/tests/common",
        "//codex-rs/exec-server",
        "//codex-rs/exec-server/testing:wine-exec-server-test-support",
        "//codex-rs/features",
        "//codex-rs/protocol",
        "//codex-rs/utils/path-uri",
        "@crates//:anyhow",
        "@crates//:pretty_assertions",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
