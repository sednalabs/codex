load("@apple_support//xcode:xcode_config.bzl", "xcode_config")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

# Set for builds that need custom V8 C++ flags or source instrumentation.
bool_flag(
    name = "rusty_v8_from_source",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

xcode_config(name = "disable_xcode")

# We mark the local platform as glibc-compatible so that rust can grab a toolchain for us.
# TODO(zbarsky): Upstream a better libc constraint into rules_rust.
# We only enable this on linux though for sanity, and because it breaks remote execution.
platform(
    name = "local_linux",
    constraint_values = [
        # We mark the local platform as glibc-compatible because musl-built rust cannot dlopen proc macros.
        "@rules_rs//rs/platforms/constraints:glibc",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "linux_x86_64_gnu",
    constraint_values = ["@llvm//constraints/libc:gnu.2.28"],
    parents = ["@rules_rs//rs/platforms:x86_64-unknown-linux-gnu"],
)

platform(
    name = "linux_aarch64_gnu",
    constraint_values = ["@llvm//constraints/libc:gnu.2.28"],
    parents = ["@rules_rs//rs/platforms:aarch64-unknown-linux-gnu"],
)

# GNU and static musl tests execute on the matching native GNU runner. Keep
# the CPU explicit so a cross-built test cannot select the wrong host.
[
    toolchain(
        name = "linux_" + cpu + "_" + libc + "_tests_toolchain",
        exec_compatible_with = [
            "@platforms//cpu:" + cpu,
            "@platforms//os:linux",
            "@rules_rs//rs/platforms/constraints:glibc",
        ],
        target_compatible_with = [
            "@platforms//cpu:" + cpu,
            "@platforms//os:linux",
            "@rules_rs//rs/platforms/constraints:" + libc,
        ],
        toolchain = "@bazel_tools//tools/test:empty_toolchain",
        toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
    for libc in [
        "glibc",
        "musl",
    ]
]

platform(
    name = "local_windows",
    constraint_values = [
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "local_windows_msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "windows_x86_64_gnullvm",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
)

platform(
    name = "windows_x86_64_msvc",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
)

toolchain(
    name = "windows_gnullvm_tests_on_msvc_host_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:gnullvm",
        "@llvm//constraints/windows/crt:msvcrt",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)

alias(
    name = "rbe",
    actual = "@rbe_platform",
)

exports_files([
    "workspace_root_test_launcher.bat.tpl",
    "workspace_root_test_launcher.sh.tpl",
])
