load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load(":defs.bzl", "BWRAP_INTEGRATION_TEST_EXEC_PROPERTIES")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

rust_binary(
    name = "bwrap-smoke",
    testonly = True,
    srcs = ["fixtures/bwrap_smoke.rs"],
    crate_name = "bwrap_smoke",
    crate_root = "fixtures/bwrap_smoke.rs",
    edition = "2024",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:private"],
    deps = [
        "@crates//:anyhow",
        "@crates//:libc",
    ],
)

# This non-manual target is part of `bazel test //...` in the Bazel workflow.
# The Firecracker execution properties provide the outer namespace boundary
# required for the nested-bubblewrap topology assertions.
rust_test(
    name = "bwrap-test-support-tests",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
        "src/sandbox_init.rs",
    ],
    crate_name = "bwrap_test_support",
    crate_root = "src/lib.rs",
    data = [
        ":bwrap-smoke",
        "//codex-rs/bwrap:bwrap",
    ],
    edition = "2024",
    env = {
        "CARGO_BIN_EXE_bwrap": "$(rlocationpath //codex-rs/bwrap:bwrap)",
        "CARGO_BIN_EXE_bwrap-smoke": "$(rlocationpath :bwrap-smoke)",
    },
    exec_properties = BWRAP_INTEGRATION_TEST_EXEC_PROPERTIES,
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "long",
    deps = [
        "//codex-rs/utils/cargo-bin",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:libc",
        "@crates//:pretty_assertions",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
