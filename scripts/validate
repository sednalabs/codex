#!/usr/bin/env python3
"""Dispatch or preview a hosted exact-test validation request.

The default is a no-write dry run.  ``--dispatch`` is the explicit mutation
boundary.  ``--watch`` is a separate blocking wait over an exact run id and
never implements a polling loop here.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
from pathlib import Path


SCHEMA_VERSION = "rust-tests-v1"
SAFE_REF = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}$")
SHA = re.compile(r"^[0-9a-fA-F]{40}$")
TRUSTED_REPO = "sednalabs/codex"
TRUSTED_WORKFLOW_HOST_REF = "main"
PROFILES = {"rust_minimal", "rust_integration"}
PACKAGE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
TARGET_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")
TEST_RE = re.compile(r"^[A-Za-z0-9_:.\-]{1,255}$")
TARGET_KINDS = {"lib", "integration"}
MAX_TESTS = 64
MAX_REQUEST_CHARS = 32768
COMMAND_MANIFEST = Path(__file__).resolve().parents[1] / ".github" / "validation-named-tests.json"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", default="sednalabs/codex")
    parser.add_argument("--workflow-host-ref", default="main")
    parser.add_argument("--target-sha")
    parser.add_argument("--base-ref", default="main")
    parser.add_argument("--profile", choices=sorted(PROFILES), default="rust_minimal")
    parser.add_argument("--request-json")
    parser.add_argument("--dispatch", action="store_true")
    parser.add_argument("--watch", action="store_true")
    parser.add_argument("--run-id", type=int)
    return parser.parse_args()


def normalize_request(raw: str, profile: str) -> tuple[str, dict]:
    if not isinstance(raw, str) or len(raw) > MAX_REQUEST_CHARS:
        raise SystemExit(f"request JSON must be at most {MAX_REQUEST_CHARS} characters")
    if profile not in PROFILES:
        raise SystemExit("request profile is not an allowed validation profile")
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"request JSON is invalid: {exc}") from exc
    if not isinstance(payload, dict) or payload.get("schema_version") != SCHEMA_VERSION:
        raise SystemExit(f"request must be a {SCHEMA_VERSION} object")
    # The hosted runner owns the definitive schema validation.  These local
    # checks prevent an obvious malformed dispatch while keeping dry-run cheap.
    package = payload.get("package")
    target_kind = payload.get("target_kind")
    target = payload.get("target", "")
    tests = payload.get("tests")
    if not isinstance(package, str) or not PACKAGE_RE.fullmatch(package):
        raise SystemExit("request.package must be a safe Cargo package name")
    if target_kind not in TARGET_KINDS:
        raise SystemExit("request.target_kind must be lib or integration")
    if target_kind == "integration":
        if not isinstance(target, str) or not TARGET_RE.fullmatch(target):
            raise SystemExit("request.target must be a safe integration target name")
    elif target not in ("", None, "lib"):
        raise SystemExit("request.target must be empty for lib requests")
    if not isinstance(tests, list) or not tests or len(tests) > MAX_TESTS:
        raise SystemExit(f"request.tests must contain 1..{MAX_TESTS} names")
    if any(not isinstance(name, str) or not TEST_RE.fullmatch(name) for name in tests):
        raise SystemExit("request.tests must contain fully-qualified safe names")
    if len(set(tests)) != len(tests):
        raise SystemExit("request.tests must not contain duplicates")
    if payload.get("profile") != profile:
        raise SystemExit("request profile must match --profile")
    normalized = {
        "schema_version": SCHEMA_VERSION,
        "profile": profile,
        "package": package,
        "target_kind": target_kind,
        "target": "" if target in (None, "lib") else target,
        "tests": tests,
    }
    try:
        catalog = json.loads(COMMAND_MANIFEST.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SystemExit(f"named-test command catalog is unavailable: {exc}") from exc
    targets = catalog.get("targets") if isinstance(catalog, dict) else None
    if not isinstance(targets, list) or not any(
        isinstance(row, dict)
        and row.get("package") == normalized["package"]
        and row.get("target_kind") == normalized["target_kind"]
        and row.get("target", "") == normalized["target"]
        and profile in (row.get("profiles") or [])
        for row in targets
    ):
        raise SystemExit("request target is not in the committed command catalog")
    return json.dumps(normalized, sort_keys=True, separators=(",", ":")), normalized


def request_payload(args: argparse.Namespace) -> tuple[str, dict]:
    return normalize_request(str(args.request_json), args.profile)


def validate_command_inputs(args: argparse.Namespace, *, require_target_sha: bool = True) -> None:
    """Fail closed before constructing a fixed-executable argv."""

    if args.repo != TRUSTED_REPO:
        raise SystemExit(f"--repo must be exactly {TRUSTED_REPO}")
    if args.profile not in PROFILES:
        raise SystemExit("--profile must be an allowed validation profile")
    if require_target_sha and (not args.target_sha or not SHA.fullmatch(args.target_sha)):
        raise SystemExit("--target-sha must be a full 40-character commit SHA")
    if args.workflow_host_ref != TRUSTED_WORKFLOW_HOST_REF:
        raise SystemExit(f"--workflow-host-ref must be exactly {TRUSTED_WORKFLOW_HOST_REF}")
    if not SAFE_REF.fullmatch(args.base_ref):
        raise SystemExit("--base-ref must be a safe repository ref name")


def plan(args: argparse.Namespace, request_json: str) -> dict:
    return {
        "workflow": "validation-named-tests.yml",
        "repo": args.repo,
        "workflow_host_ref": args.workflow_host_ref,
        "target_sha": args.target_sha.lower(),
        "base_ref": args.base_ref,
        "profile": args.profile,
        "request": json.loads(request_json),
        "mutation": "dispatch" if args.dispatch else "dry-run",
        "blocking_watch": bool(args.watch),
    }


def gh_command(args: argparse.Namespace, request_json: str) -> list[str]:
    validate_command_inputs(args)
    normalize_request(request_json, args.profile)
    # Keep the complete command line constant.  Dispatch values are supplied
    # as JSON on stdin below, so no operator-controlled value reaches an argv
    # slot or can be reinterpreted as a command option.
    return [
        "gh",
        "workflow",
        "run",
        "validation-named-tests.yml",
        "--repo",
        TRUSTED_REPO,
        "--ref",
        TRUSTED_WORKFLOW_HOST_REF,
        "--json",
    ]


def gh_workflow_input(args: argparse.Namespace, request_json: str) -> str:
    """Serialize validated workflow inputs for gh's JSON stdin contract."""

    validate_command_inputs(args)
    request_json, _ = normalize_request(request_json, args.profile)
    return (
        json.dumps(
            {
                "target_sha": args.target_sha.lower(),
                "base_ref": args.base_ref,
                "profile": args.profile,
                "request_json": request_json,
            },
            sort_keys=True,
            separators=(",", ":"),
        )
        + "\n"
    )


def watch_run(args: argparse.Namespace) -> int:
    if args.run_id is None or args.run_id <= 0:
        raise SystemExit("--watch requires a positive --run-id")
    # The run id is an integer and the repository has a strict owner/name
    # shape; this argv-only invocation never evaluates user input as a shell.
    return subprocess.run(
        ["gh", "run", "watch", str(args.run_id), "--repo", args.repo, "--exit-status"],
        check=False,
        shell=False,
    ).returncode


def main() -> int:
    args = parse_args()
    validate_command_inputs(args, require_target_sha=False) if args.watch else None
    if args.watch:
        if args.dispatch:
            raise SystemExit("--watch and --dispatch are separate operations")
        if args.run_id is None or args.run_id <= 0:
            raise SystemExit("--watch requires a positive --run-id")
        print(json.dumps({"repo": args.repo, "run_id": args.run_id, "mutation": "blocking-watch"}))
        return watch_run(args)
    if not args.request_json:
        raise SystemExit("--request-json is required for preview or dispatch")
    validate_command_inputs(args)
    request_json, _ = request_payload(args)
    print(json.dumps(plan(args, request_json), indent=2, sort_keys=True))
    if not args.dispatch:
        return 0
    # Security invariant: the executable, repository, workflow ref, and all
    # option names are fixed literals. Validated values travel only as JSON
    # over stdin; shell=False is explicit and no arbitrary flags can occur.
    return subprocess.run(
        gh_command(args, request_json),
        input=gh_workflow_input(args, request_json),
        text=True,
        check=False,
        shell=False,
    ).returncode


if __name__ == "__main__":
    raise SystemExit(main())
