#!/usr/bin/env python3
"""Dispatch or preview a hosted exact-test validation request.

The default is a no-write dry run.  ``--dispatch`` is the explicit mutation
boundary; ``--watch`` delegates the blocking wait to the repository's
SHA-guarded workflow watcher and never implements a polling loop here.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path


SCHEMA_VERSION = "rust-tests-v1"
SAFE_REF = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/@:+-]{0,199}$")
SHA = re.compile(r"^[0-9a-fA-F]{40}$")
PROFILES = {"rust_minimal", "rust_integration"}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", default="sednalabs/codex")
    parser.add_argument("--workflow-host-ref", default="main")
    parser.add_argument("--target-sha", required=True)
    parser.add_argument("--base-ref", default="main")
    parser.add_argument("--profile", choices=sorted(PROFILES), default="rust_minimal")
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--request-file")
    source.add_argument("--request-json")
    parser.add_argument("--dispatch", action="store_true")
    parser.add_argument("--watch", action="store_true")
    parser.add_argument("--max-wait-seconds", type=int, default=7200)
    return parser.parse_args()


def request_payload(args: argparse.Namespace) -> tuple[str, dict]:
    raw = (
        Path(args.request_file).read_text(encoding="utf-8")
        if args.request_file
        else str(args.request_json)
    )
    try:
        payload = json.loads(raw)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SystemExit(f"request JSON is invalid: {exc}") from exc
    if not isinstance(payload, dict) or payload.get("schema_version") != SCHEMA_VERSION:
        raise SystemExit(f"request must be a {SCHEMA_VERSION} object")
    # The hosted runner owns the definitive schema validation.  These local
    # checks prevent an obvious malformed dispatch while keeping dry-run cheap.
    if not isinstance(payload.get("tests"), list) or not payload["tests"]:
        raise SystemExit("request.tests must be a non-empty array")
    if payload.get("profile") != args.profile:
        raise SystemExit("request profile must match --profile")
    return json.dumps(payload, sort_keys=True, separators=(",", ":")), payload


def plan(args: argparse.Namespace, request_json: str) -> dict:
    return {
        "workflow": "validation-named-tests.yml",
        "repo": args.repo,
        "workflow_host_ref": args.workflow_host_ref,
        "target_sha": args.target_sha.lower(),
        "base_ref": args.base_ref,
        "profile": args.profile,
        "request": json.loads(request_json),
        "mutation": "dispatch" if args.dispatch else "dry-run",
        "blocking_watch": bool(args.watch),
    }


def gh_command(args: argparse.Namespace, request_json: str) -> list[str]:
    return [
        "gh",
        "workflow",
        "run",
        "validation-named-tests.yml",
        "--repo",
        args.repo,
        "--ref",
        args.workflow_host_ref,
        "-f",
        f"target_sha={args.target_sha.lower()}",
        "-f",
        f"base_ref={args.base_ref}",
        "-f",
        f"profile={args.profile}",
        "-f",
        f"request_json={request_json}",
    ]


def host_sha(args: argparse.Namespace) -> str:
    completed = subprocess.run(
        ["gh", "api", f"repos/{args.repo}/commits/{args.workflow_host_ref}", "--jq", ".sha"],
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode != 0 or not SHA.fullmatch(completed.stdout.strip()):
        raise SystemExit("could not resolve the exact workflow-host SHA")
    return completed.stdout.strip()


def dispatch_and_watch(args: argparse.Namespace, request_json: str) -> int:
    watcher_value = os.environ.get("CODEX_WORKFLOW_WATCHER", "")
    if not watcher_value:
        raise SystemExit(
            "set CODEX_WORKFLOW_WATCHER to the installed SHA-guarded blocking "
            "workflow watcher before using --watch"
        )
    watcher = Path(watcher_value)
    if not watcher.is_file():
        raise SystemExit(f"blocking workflow watcher is unavailable: {watcher}")
    command = [
        sys.executable,
        str(watcher),
        "--workflow",
        "validation-named-tests.yml",
        "--repo",
        args.repo,
        "--ref",
        args.workflow_host_ref,
        "--head-sha",
        host_sha(args),
        "--wait-for",
        "all_done",
        "--watch-until-terminal",
        "--max-wait-seconds",
        str(args.max_wait_seconds),
    ]
    for key, value in (
        ("target_sha", args.target_sha.lower()),
        ("base_ref", args.base_ref),
        ("profile", args.profile),
        ("request_json", request_json),
    ):
        command.extend(["--input", f"{key}={value}"])
    return subprocess.run(command, check=False).returncode


def main() -> int:
    args = parse_args()
    if not SHA.fullmatch(args.target_sha):
        raise SystemExit("--target-sha must be a full 40-character commit SHA")
    if not SAFE_REF.fullmatch(args.workflow_host_ref) or not SAFE_REF.fullmatch(args.base_ref):
        raise SystemExit("refs must be safe repository ref names")
    if args.watch and not args.dispatch:
        raise SystemExit("--watch requires explicit --dispatch")
    request_json, _ = request_payload(args)
    print(json.dumps(plan(args, request_json), indent=2, sort_keys=True))
    if not args.dispatch:
        return 0
    if args.watch:
        return dispatch_and_watch(args, request_json)
    return subprocess.run(gh_command(args, request_json), check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
