#!/usr/bin/env bash
set -euo pipefail

repository="${GITHUB_REPOSITORY:-}"
release_tag=""
dry_run=false
allow_prerelease=false
macos_preview=false
verify_attestation=false
verify_signatures=false

usage() {
  echo "usage: install_sedna_release_asset --repository sednalabs/codex --release-tag TAG|latest [--dry-run] [--allow-prerelease] [--verify-signatures] [--verify-attestation] [--macos-preview]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repository)
      repository="${2:-}"
      shift 2
      ;;
    --release-tag)
      release_tag="${2:-}"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --allow-prerelease)
      allow_prerelease=true
      shift
      ;;
    --macos-preview)
      macos_preview=true
      shift
      ;;
    --verify-attestation)
      verify_attestation=true
      shift
      ;;
    --verify-signatures)
      verify_signatures=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      echo "error: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [[ "$(printf '%s' "$repository" | tr '[:upper:]' '[:lower:]')" != "sednalabs/codex" ]]; then
  printf 'error: repository must be sednalabs/codex, got %s\n' "$repository" >&2
  exit 1
fi

host_os="$(uname -s)"
host_arch="$(uname -m)"
case "${host_os}/${host_arch}" in
  Linux/x86_64|Linux/amd64)
    target="x86_64-unknown-linux-gnu"
    checksum_name="SHA256SUMS.txt"
    metadata_name="RELEASE-METADATA.json"
    ;;
  Linux/aarch64|Linux/arm64)
    target="aarch64-unknown-linux-gnu"
    checksum_name="SHA256SUMS-${target}.txt"
    metadata_name="RELEASE-METADATA-${target}.json"
    ;;
  Darwin/x86_64)
    target="x86_64-apple-darwin"
    if [[ "$macos_preview" == "true" ]]; then
      checksum_name="SHA256SUMS-${target}-UNNOTARIZED-PREVIEW.txt"
      metadata_name="RELEASE-METADATA-${target}-UNNOTARIZED-PREVIEW.json"
    else
      checksum_name="SHA256SUMS-${target}.txt"
      metadata_name="RELEASE-METADATA-${target}.json"
    fi
    ;;
  *)
    printf 'error: unsupported release platform: %s/%s (supported: Linux/x86_64, Linux/aarch64, Darwin/x86_64)\n' \
      "$host_os" "$host_arch" >&2
    exit 1
    ;;
esac

api_root="https://api.github.com/repos/sednalabs/codex"
install_root="${HOME}/.codex/packages/standalone"
bin_dir="${HOME}/.local/bin"

work_dir="$(mktemp -d -t sedna-release-install.XXXXXX)"
cleanup() {
  rm -rf "$work_dir"
}
trap cleanup EXIT

github_header=(
  -H "User-Agent: sedna-release-install"
  -H "X-GitHub-Api-Version: 2022-11-28"
)
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  github_header+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
fi

fetch_json() {
  local url="$1"
  local output="$2"
  curl --fail --location --silent --show-error \
    "${github_header[@]}" \
    -H "Accept: application/vnd.github+json" \
    "$url" \
    --output "$output"
}

fetch_asset() {
  local asset_id="$1"
  local output="$2"
  curl --fail --location --silent --show-error \
    "${github_header[@]}" \
    -H "Accept: application/octet-stream" \
    "${api_root}/releases/assets/${asset_id}" \
    --output "$output"
}

if [[ "$release_tag" == "latest" ]]; then
  latest_json="${work_dir}/latest-release.json"
  fetch_json "${api_root}/releases/latest" "$latest_json"
  release_tag="$(python3 - "$latest_json" <<'PY'
import json
import sys

release = json.loads(open(sys.argv[1], encoding="utf-8").read())
tag = release.get("tag_name")
if not isinstance(tag, str) or not tag:
    raise SystemExit("error: latest release did not include tag_name")
print(tag)
PY
)"
fi

if [[ ! "$release_tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?-sedna\.[0-9]+(\+upstream\.[0-9]+)?$ ]]; then
  printf 'error: release tag must look like v0.124.0-sedna.2 or v0.126.0-alpha.5-sedna.1+upstream.1, got %s\n' "$release_tag" >&2
  exit 1
fi

release_version="${release_tag#v}"
archive_name="codex-sedna-${release_version}-${target}.tar.gz"
if [[ "$target" == "x86_64-apple-darwin" && "$macos_preview" == "true" ]]; then
  archive_name="codex-sedna-${release_version}-${target}-UNNOTARIZED-PREVIEW.tar.gz"
fi

archive_base="${archive_name%.tar.gz}"
sbom_name="${archive_base}.spdx.json"
attestation_bundle_name="${archive_base}.intoto.jsonl"
codex_sigstore_name="${archive_base}-codex.sigstore"
proxy_sigstore_name="${archive_base}-codex-responses-api-proxy.sigstore"
require_linux_signatures=false
require_linux_provenance=false
verify_linux_elf=false
if [[ "$target" == "aarch64-unknown-linux-gnu" ]]; then
  # Arm64 first ships with the hardened trust contract, so there is no legacy
  # Arm release mode in which these verifications may be omitted.
  verify_signatures=true
  verify_attestation=true
fi
if [[ "$verify_signatures" == "true" ]]; then
  require_linux_signatures=true
fi
if [[ "$verify_attestation" == "true" ]]; then
  require_linux_provenance=true
fi
if [[ "$target" == *-unknown-linux-gnu && ( "$verify_signatures" == "true" || "$verify_attestation" == "true" ) ]]; then
  verify_linux_elf=true
fi

release_json="${work_dir}/release.json"
fetch_json "${api_root}/releases/tags/${release_tag}" "$release_json"

python3 - "$release_json" "$release_tag" "$allow_prerelease" <<'PY'
import json
import sys

path, expected_tag, allow_prerelease = sys.argv[1:4]
release = json.loads(open(path, encoding="utf-8").read())
if release.get("draft"):
    raise SystemExit(f"error: refusing draft release {expected_tag}")
if release.get("prerelease") and allow_prerelease != "true":
    raise SystemExit(f"error: refusing prerelease {expected_tag}; pass --allow-prerelease to override")
if release.get("tag_name") != expected_tag:
    raise SystemExit(f"error: release API returned tag {release.get('tag_name')!r}, expected {expected_tag!r}")
PY

asset_manifest="${work_dir}/assets.tsv"
python3 - "$release_json" "$archive_name" "$checksum_name" "$metadata_name" "$sbom_name" "$attestation_bundle_name" "$codex_sigstore_name" "$proxy_sigstore_name" "$require_linux_signatures" "$require_linux_provenance" > "$asset_manifest" <<'PY'
import json
import sys

release_path, archive_name, checksum_name, metadata_name, sbom_name, attestation_bundle_name, codex_sigstore_name, proxy_sigstore_name, require_linux_signatures, require_linux_provenance = sys.argv[1:11]
required = [archive_name, checksum_name, metadata_name]
if require_linux_signatures == "true":
    required.extend((codex_sigstore_name, proxy_sigstore_name))
if require_linux_provenance == "true":
    required.extend((sbom_name, attestation_bundle_name))
release = json.loads(open(release_path, encoding="utf-8").read())
assets = {asset.get("name"): asset for asset in release.get("assets", [])}
missing = [name for name in required if name not in assets]
if missing:
    raise SystemExit(f"error: release is missing required assets: {', '.join(missing)}")
for name in required:
    asset_id = assets[name].get("id")
    if not isinstance(asset_id, int):
        raise SystemExit(f"error: release asset {name!r} has no numeric id")
    print(f"{name}\t{asset_id}")
PY

while IFS=$'\t' read -r name asset_id; do
  case "$name" in
    "$archive_name")
      fetch_asset "$asset_id" "${work_dir}/${archive_name}"
      ;;
    "$checksum_name")
      fetch_asset "$asset_id" "${work_dir}/${checksum_name}"
      ;;
    "$metadata_name")
      fetch_asset "$asset_id" "${work_dir}/${metadata_name}"
      ;;
    "$sbom_name"|"$attestation_bundle_name"|"$codex_sigstore_name"|"$proxy_sigstore_name")
      fetch_asset "$asset_id" "${work_dir}/${name}"
      ;;
  esac
done < "$asset_manifest"

python3 - "$work_dir" "$archive_name" "$checksum_name" "$metadata_name" "$release_tag" "$release_version" "$target" "$macos_preview" "$sbom_name" "$attestation_bundle_name" "$codex_sigstore_name" "$proxy_sigstore_name" "$require_linux_signatures" "$require_linux_provenance" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

work_dir, archive_name, checksum_name, metadata_name, release_tag, release_version, target, macos_preview, sbom_name, attestation_bundle_name, codex_sigstore_name, proxy_sigstore_name, require_linux_signatures, require_linux_provenance = sys.argv[1:15]
root = Path(work_dir)
metadata = json.loads((root / metadata_name).read_text(encoding="utf-8"))
expected = {
    "release_tag": release_tag,
    "release_version": release_version,
    "target": target,
}
for key, value in expected.items():
    if metadata.get(key) != value:
        raise SystemExit(f"error: metadata {key}={metadata.get(key)!r}, expected {value!r}")
if str(metadata.get("repository", "")).lower() != "sednalabs/codex":
    raise SystemExit(f"error: metadata repository={metadata.get('repository')!r}, expected 'sednalabs/codex'")
if target == "x86_64-apple-darwin":
    expected_trust = (
        {
            "distribution": "preview",
            "signing": "ad-hoc",
            "notarized": False,
            "gatekeeper_ready": False,
        }
        if macos_preview == "true"
        else {"signing": "developer-id", "notarized": True}
    )
    for key, value in expected_trust.items():
        if metadata.get(key) != value:
            raise SystemExit(
                f"error: metadata {key}={metadata.get(key)!r}, expected {value!r}"
            )

checksums = {}
for raw in (root / checksum_name).read_text(encoding="utf-8").splitlines():
    fields = raw.strip().split()
    if len(fields) >= 2:
        digest, name = fields[0], fields[1].lstrip("*").removeprefix("./")
        if not re.fullmatch(r"[0-9a-fA-F]{64}", digest):
            raise SystemExit(f"error: invalid SHA-256 digest for {name!r}")
        if name in checksums:
            raise SystemExit(f"error: duplicate checksum entry for {name!r}")
        checksums[name] = digest.lower()
required_assets = [archive_name, metadata_name]
if require_linux_signatures == "true":
    required_assets.extend((codex_sigstore_name, proxy_sigstore_name))
if require_linux_provenance == "true":
    required_assets.extend((sbom_name, attestation_bundle_name))
for name in required_assets:
    digest = checksums.get(name)
    if digest is None:
        raise SystemExit(f"error: {checksum_name} does not include {name}")
    actual = hashlib.sha256((root / name).read_bytes()).hexdigest()
    if actual != digest:
        raise SystemExit(f"error: checksum mismatch for {name}: expected {digest}, got {actual}")
if require_linux_provenance == "true":
    sbom = json.loads((root / sbom_name).read_text(encoding="utf-8"))
    if sbom.get("spdxVersion") != "SPDX-2.3":
        raise SystemExit(f"error: {sbom_name} is not an SPDX 2.3 document")
PY

staged="${work_dir}/stage"
mkdir "$staged"
python3 - "$work_dir/$archive_name" "$staged" <<'PY'
import shutil
import sys
import tarfile
from pathlib import Path

archive_path, destination = sys.argv[1:3]
destination_path = Path(destination)
allowed = {"codex", "codex-responses-api-proxy"}
seen = set()
with tarfile.open(archive_path, mode="r:gz") as archive:
    for member in archive.getmembers():
        if member.name in ("", ".", "./"):
            continue
        if member.name.startswith("/") or "\\" in member.name:
            raise SystemExit(f"error: refusing unsafe archive member {member.name!r}")
        parts = [part for part in member.name.split("/") if part not in ("", ".")]
        if len(parts) != 1 or parts[0] not in allowed or any(part == ".." for part in parts):
            raise SystemExit(f"error: refusing unexpected archive member {member.name!r}")
        if not member.isfile():
            raise SystemExit(f"error: refusing unsafe archive member {member.name!r}")
        if parts[0] in seen:
            raise SystemExit(f"error: refusing duplicate archive member {member.name!r}")
        seen.add(parts[0])
        source = archive.extractfile(member)
        if source is None:
            raise SystemExit(f"error: failed to read archive member {member.name!r}")
        target = destination_path / parts[0]
        with source, target.open("wb") as output:
            shutil.copyfileobj(source, output)
        target.chmod(member.mode & 0o777)
missing = allowed - seen
if missing:
    raise SystemExit(f"error: archive is missing required members: {', '.join(sorted(missing))}")
PY
cp "$work_dir/$metadata_name" "$staged/RELEASE-METADATA.json"
cp "$work_dir/$checksum_name" "$staged/SHA256SUMS.txt"

for executable in codex codex-responses-api-proxy; do
  if [[ ! -x "$staged/$executable" ]]; then
    echo "error: required executable is missing or not executable: $executable" >&2
    exit 1
  fi
done

if [[ "$verify_linux_elf" == "true" ]]; then
  expected_elf_arch="x86-64"
  if [[ "$target" == "aarch64-unknown-linux-gnu" ]]; then
    expected_elf_arch="ARM aarch64"
    expected_elf_interpreter="/lib/ld-linux-aarch64.so.1"
  else
    expected_elf_interpreter="/lib64/ld-linux-x86-64.so.2"
  fi
  for executable in codex codex-responses-api-proxy; do
    file_output="$(file -b "$staged/$executable")"
    if [[ "$file_output" != *"ELF"* || "$file_output" != *"$expected_elf_arch"* ]]; then
      printf 'error: %s has unexpected binary architecture for %s: %s\n' \
        "$executable" "$target" "$file_output" >&2
      exit 1
    fi
    if ! readelf -l "$staged/$executable" | grep -F "$expected_elf_interpreter" >/dev/null; then
      printf 'error: %s does not use the expected GNU/Linux interpreter for %s: %s\n' \
        "$executable" "$target" "$expected_elf_interpreter" >&2
      exit 1
    fi
  done
fi

if [[ "$verify_signatures" == "true" ]]; then
  if ! command -v cosign >/dev/null 2>&1; then
    echo "error: cosign is required to verify Linux release signatures" >&2
    exit 1
  fi
  certificate_identity_regexp='^https://github\.com/sednalabs/codex/\.github/workflows/sedna-release\.yml@refs/(heads/main|tags/v[^/]+)$'
  cosign verify-blob \
    --bundle "$work_dir/$codex_sigstore_name" \
    --certificate-identity-regexp "$certificate_identity_regexp" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com \
    "$staged/codex"
  cosign verify-blob \
    --bundle "$work_dir/$proxy_sigstore_name" \
    --certificate-identity-regexp "$certificate_identity_regexp" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com \
    "$staged/codex-responses-api-proxy"

fi

if [[ "$verify_attestation" == "true" ]]; then
  if ! command -v gh >/dev/null 2>&1; then
    echo "error: a GitHub CLI version with 'gh attestation verify' is required to verify build attestations" >&2
    exit 1
  fi
  if ! gh_attestation_help="$(gh attestation verify --help 2>&1)" || [[ "$gh_attestation_help" != *"--deny-self-hosted-runners"* ]]; then
    echo "error: a GitHub CLI version with hosted-runner attestation enforcement is required" >&2
    exit 1
  fi
  gh attestation verify "$work_dir/$archive_name" \
    --repo sednalabs/codex \
    --deny-self-hosted-runners \
    --signer-workflow sednalabs/codex/.github/workflows/sedna-release.yml
  gh attestation verify "$work_dir/$sbom_name" \
    --repo sednalabs/codex \
    --deny-self-hosted-runners \
    --signer-workflow sednalabs/codex/.github/workflows/sedna-release.yml
  gh attestation verify "$work_dir/$metadata_name" \
    --repo sednalabs/codex \
    --deny-self-hosted-runners \
    --signer-workflow sednalabs/codex/.github/workflows/sedna-release.yml
fi

if [[ "$target" == "x86_64-apple-darwin" ]]; then
  for executable in codex codex-responses-api-proxy; do
    if ! codesign --verify --strict "$staged/$executable"; then
      echo "error: macOS code signature verification failed: $executable" >&2
      exit 1
    fi
  done
fi

staged_version_output="$("$staged/codex" --version 2>&1)"
if [[ "$staged_version_output" != *"$release_version"* ]]; then
  printf 'error: staged codex --version did not report %s: %s\n' "$release_version" "$staged_version_output" >&2
  exit 1
fi
"$staged/codex" --help >/dev/null
"$staged/codex" exec --help >/dev/null
"$staged/codex" app-server --help >/dev/null
"$staged/codex-responses-api-proxy" --help >/dev/null

release_dir_name="${release_tag}"
if [[ "$target" != "x86_64-unknown-linux-gnu" ]]; then
  release_dir_name="${release_tag}-${target}"
fi
release_dir="${install_root}/releases/${release_dir_name}"
if [[ -d "$release_dir" ]]; then
  python3 - "$release_dir/RELEASE-METADATA.json" "$release_tag" "$target" <<'PY'
import json
import sys

metadata_path, expected_tag, expected_target = sys.argv[1:4]
metadata = json.loads(open(metadata_path, encoding="utf-8").read())
if metadata.get("release_tag") != expected_tag:
    raise SystemExit(f"error: existing release metadata tag does not match {expected_tag}")
actual_target = metadata.get("target")
if actual_target not in (None, expected_target):
    raise SystemExit(
        f"error: existing release metadata target {actual_target!r} does not match {expected_target}"
    )
if actual_target is None and expected_target != "x86_64-unknown-linux-gnu":
    raise SystemExit("error: non-x86 release metadata must include its target")
PY
  for executable in codex codex-responses-api-proxy; do
    if [[ ! -x "$release_dir/$executable" ]]; then
      echo "error: existing release is missing required executable: $executable" >&2
      exit 1
    fi
  done
fi

if [[ "$dry_run" == "true" ]]; then
  echo "dry-run: verified sednalabs/codex@${release_tag} for ${target}"
  echo "$staged_version_output"
  exit 0
fi

mkdir -p "${install_root}/releases" "$bin_dir"
if [[ ! -d "$release_dir" ]]; then
  tmp_release="${install_root}/releases/.${release_dir_name}.tmp.$$"
  rm -rf "$tmp_release"
  mkdir "$tmp_release"
  cp -p "$staged/codex" "$tmp_release/codex"
  cp -p "$staged/codex-responses-api-proxy" "$tmp_release/codex-responses-api-proxy"
  cp "$staged/RELEASE-METADATA.json" "$tmp_release/RELEASE-METADATA.json"
  cp "$staged/SHA256SUMS.txt" "$tmp_release/SHA256SUMS.txt"
  mv "$tmp_release" "$release_dir"
fi

current_tmp="${install_root}/.current.tmp.$$"
ln -s "$release_dir" "$current_tmp"
python3 - "$current_tmp" "${install_root}/current" <<'PY'
import os
import sys

os.replace(sys.argv[1], sys.argv[2])
PY

visible_codex="${bin_dir}/codex"
if [[ -e "$visible_codex" && ! -L "$visible_codex" ]]; then
  mkdir -p "${install_root}/backups"
  backup="${install_root}/backups/codex.$(date +%s)"
  mv "$visible_codex" "$backup"
  echo "backed up previous codex binary"
fi

codex_tmp="${bin_dir}/.codex.tmp.$$"
ln -s "${release_dir}/codex" "$codex_tmp"
python3 - "$codex_tmp" "$visible_codex" <<'PY'
import os
import sys

os.replace(sys.argv[1], sys.argv[2])
PY

visible_version_output="$("$visible_codex" --version 2>&1)"
if [[ "$visible_version_output" != *"$release_version"* ]]; then
  printf 'error: codex --version did not report %s: %s\n' "$release_version" "$visible_version_output" >&2
  exit 1
fi

echo "installed sednalabs/codex@${release_tag}"
echo "$visible_version_output"
