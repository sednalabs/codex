+fn webrtc_scratch_dir() -> path::PathBuf {
+    // Dependency outputs are read-only in Bazel; use the calling action's output.
+    if env::var_os("WEBRTC_SYS_LINK_OUT_DIR").is_some() {
+        path::PathBuf::from(env::var_os("OUT_DIR").unwrap()).join(SCRATH_PATH)
+    } else {
+        scratch::path(SCRATH_PATH)
+    }
+}
