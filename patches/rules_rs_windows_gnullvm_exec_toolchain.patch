# What: register a distinct gnullvm Rust execution toolchain on Windows.
# Why: native gnullvm proc macros must load against the matching Rust runtime;
# the generic MSVC execution toolchain leaves those DLLs unloadable.
# Scope: Rust compiler tools only. Miri and module-extension host Cargo retain
# their existing MSVC-only exec set.

diff --git a/rs/platforms/triples.bzl b/rs/platforms/triples.bzl
--- a/rs/platforms/triples.bzl
+++ b/rs/platforms/triples.bzl
@@ -61,0 +62,6 @@ SUPPORTED_EXEC_TRIPLES = [
+# Miri intentionally remains on SUPPORTED_EXEC_TRIPLES. Its distributed host
+# tools do not cover this ABI, while Rust compiler tools do.
+SUPPORTED_RUST_EXEC_TRIPLES = SUPPORTED_EXEC_TRIPLES + [
+    "x86_64-pc-windows-gnullvm",
+]
+
diff --git a/rs/toolchains/declare_rust_analyzer_toolchains.bzl b/rs/toolchains/declare_rust_analyzer_toolchains.bzl
--- a/rs/toolchains/declare_rust_analyzer_toolchains.bzl
+++ b/rs/toolchains/declare_rust_analyzer_toolchains.bzl
@@ -7 +7 @@ load(
-load("//rs/platforms:triples.bzl", "SUPPORTED_EXEC_TRIPLES")
+load("//rs/platforms:triples.bzl", "SUPPORTED_RUST_EXEC_TRIPLES", "triple_to_rust_constraint_set")
@@ -16,0 +17,5 @@ def _channel(version):
+def _exec_triple_suffix(exec_triple):
+    if exec_triple.system == "windows":
+        return "{}_{}_{}".format(exec_triple.system, exec_triple.arch, exec_triple.abi)
+    return "{}_{}".format(exec_triple.system, exec_triple.arch)
+
@@ -26 +31 @@ def declare_rust_analyzer_toolchains(
-        execs = SUPPORTED_EXEC_TRIPLES):
+        execs = SUPPORTED_RUST_EXEC_TRIPLES):
@@ -34 +39 @@ def declare_rust_analyzer_toolchains(
-        triple_suffix = exec_triple.system + "_" + exec_triple.arch
+        triple_suffix = _exec_triple_suffix(exec_triple)
@@ -40,3 +45,2 @@ def declare_rust_analyzer_toolchains(
-        rust_analyzer_toolchain_name = "{}_{}_{}_rust_analyzer_toolchain".format(
-            exec_triple.system,
-            exec_triple.arch,
+        rust_analyzer_toolchain_name = "{}_{}_rust_analyzer_toolchain".format(
+            triple_suffix,
@@ -60,5 +64,2 @@ def declare_rust_analyzer_toolchains(
-            name = "{}_{}_rust_analyzer_{}".format(exec_triple.system, exec_triple.arch, version_key),
-            exec_compatible_with = [
-                "@platforms//os:" + exec_triple.system,
-                "@platforms//cpu:" + exec_triple.arch,
-            ],
+            name = "{}_rust_analyzer_{}".format(triple_suffix, version_key),
+            exec_compatible_with = triple_to_rust_constraint_set(triple),
